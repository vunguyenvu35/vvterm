# Defaults for `scripts/deploy.sh prod`. Secrets are never stored here: export them in your shell or CI.
#
#   CODESIGN_IDENTITY   "Developer ID Application: Your Name (TEAMID)"  -> sign with the hardened runtime
#   NOTARY_PROFILE      name of a `xcrun notarytool store-credentials` profile -> notarize and staple
#
# Without CODESIGN_IDENTITY the app is only ad-hoc signed: fine for yourself, blocked by Gatekeeper elsewhere.
DIST_DIR="${DIST_DIR:-dist}"
RELEASE_BRANCH="${RELEASE_BRANCH:-main}"
