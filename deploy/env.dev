# Defaults for `scripts/deploy.sh dev`. Any of them can be overridden from your shell.
# Dev builds are installed side by side with the production app: own name, bundle id and data dir.
DEV_APP_DIR="${DEV_APP_DIR:-$HOME/Applications/VVTerm Dev.app}"
DEV_BIN_DIR="${DEV_BIN_DIR:-$HOME/.local/bin}"
DEV_DATA_DIR="${DEV_DATA_DIR:-$HOME/Library/Application Support/vvterm-dev}"
